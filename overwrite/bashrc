# Overwriting some behaviours for default alias

echo "Using Bash Shell"

BASHRC_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ZSH_DIR="$BASHRC_DIR/../zsh"
SCRIPT_DIR=$ZSH_DIR
[ -f "$ZSH_DIR/shell.sh" ] && source "$ZSH_DIR/shell.sh"
[ -f "$ZSH_DIR/alias.sh" ] && source "$ZSH_DIR/alias.sh"

fzf-command() {
  local cmd=$(compgen -c | fzf)
  if [[ -n $cmd ]]; then
    READLINE_LINE="$cmd"
    READLINE_POINT=${#READLINE_LINE}
  fi
}
bind -x '"\C-f": fzf-command'

src (){
  local file=${1:-~/.bashrc}
  if [[ -f $file ]]; then
    source "$file"
  fi
}
