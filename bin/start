#!/bin/bash

is_running() {
  hyprctl clients -j | jq -e --arg cls "$1" '.[] | select(.class | test($cls; "i"))' >/dev/null
}

move_to_workspace() {
  local class=$1
  local workspace=$2

  if is_running "$class"; then
    local address=$(hyprctl clients -j | jq -r --arg cls "$class" '.[] | select(.class | test($cls; "i")) | .address' | head -n1)
    if [ -n "$address" ] && [ "$address" != "null" ]; then
      hyprctl dispatch "hl.dsp.window.move({workspace = \"$workspace\", window = \"address:$address\", follow = false})"
    fi
  fi
}

launch_on_workspace() {
  local app=$1
  local workspace=$2
  local class=$3
  local delay=$4
  
  if is_running "$class"; then
    move_to_workspace "$class" "$workspace"
  else
    hyprctl dispatch "hl.dsp.exec_cmd(\"[workspace $workspace silent] $app\")"
    if [ -n "$delay" ]; then
      sleep "$delay"
      move_to_workspace "$class" "$workspace"
    fi
  fi
}

launch_on_workspace "xdg-terminal-exec" 1 "com.mitchellh.ghostty"
launch_on_workspace "zen-browser" 2 "zen"
launch_on_workspace "obsidian" 4 "obsidian"
launch_on_workspace "spotify" 5 "spotify"
