#!/bin/bash

source "$(dirname "$0")/../utils/herdr.sh"
self="$(readlink -f "$0")"

list_entries() {
  local active projects dupes
  active=$(herdr_list_workspaces)
  declare -A active_map dupe_map
  while IFS= read -r row; do
    [ -n "$row" ] && active_map["${row%%$'\t'*}"]=1
  done <<< "$active"

  current=$(herdr_current_workspace_id)
  echo "$active" | while IFS= read -r row; do
    [ -n "$row" ] || continue
    label=${row%%$'\t'*}
    id=${row#*$'\t'}
    marker=""
    [ "$id" = "$current" ] && marker="* "
    printf "\033[36m%s%s\033[0m\t%s\tactive\n" "$marker" "$label" "$id"
  done

  # Project rows; same-named projects also show their (~-collapsed) path.
  projects=$(herdr_list_projects)
  while IFS= read -r n; do
    [ -n "$n" ] && dupe_map["$n"]=1
  done <<< "$(printf '%s\n' "$projects" | cut -f1 | sort | uniq -d)"

  # Dirs of open workspaces whose label is a dupe name: their project row is
  # already covered by the active row, so it must not appear twice.
  declare -A open_dir_map
  if [ "${#dupe_map[@]}" -gt 0 ]; then
    while IFS= read -r row; do
      [ -n "$row" ] || continue
      [ "${dupe_map[${row%%$'\t'*}]:-}" ] || continue
      while IFS= read -r cwd; do
        [ -n "$cwd" ] && open_dir_map["$cwd"]=1
      done <<< "$(herdr_workspace_cwds "${row#*$'\t'}")"
    done <<< "$active"
  fi

  printf '%s\n' "$projects" | while IFS= read -r row; do
    [ -n "$row" ] || continue
    name=${row%%$'\t'*}
    d=${row#*$'\t'}
    # Dupes are always shown (an open workspace with the same label would
    # otherwise hide the other project entirely) — except the one that IS open.
    [ "${open_dir_map[$d]:-}" ] && continue
    if [ "${dupe_map[$name]:-}" ]; then
      printf "\033[32m%s\033[0m  %s\t%s\tproject\n" "$name" "$(herdr_display_path "$d")" "$d"
    elif [ "${active_map[$name]:-}" ]; then
      continue
    else
      printf "\033[32m%s\033[0m\t%s\tproject\n" "$name" "$d"
    fi
  done
}

if [ "${1:-}" = "--list" ]; then
  list_entries
  exit 0
fi
# Only ever closes real workspace ids (fzf passes column 2).
if [ "${1:-}" = "--close" ]; then
  if herdr_list_workspaces | awk -F '\t' -v id="$2" '$2==id{found=1} END{exit !found}'; then
    herdr workspace close "$2"
  fi
  exit 0
fi

selected=$(list_entries | fzf --reverse --ansi --header "Search/Create (Ctrl-d: Close)" \
  --delimiter='\t' --with-nth=1 \
  --bind="ctrl-d:execute-silent($self --close {2})+reload($self --list)+clear-query"
)

if [ -n "$selected" ]; then
  kind=$(echo "$selected" | cut -f3)
  target=$(echo "$selected" | cut -f2)
  if [ "$kind" = "active" ]; then
    herdr workspace focus "$target"
  else
    create_or_switch_workspace "$target"
  fi
fi
