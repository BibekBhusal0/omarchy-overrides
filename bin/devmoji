#!/bin/bash

declare -A EMOJIS=(
  [feat]="✨"
  [fix]="🐛"
  [docs]="📚️"
  [style]="🎨"
  [refactor]="♻️"
  [perf]="⚡️"
  [test]="🚨"
  [chore]="🔧"
  [build]="📦️"
  [ci]="👷"
  [release]="🚀"
  [security]="🔒️"
  [i18n]="🌐"
  [breaking]="💥"
  [config]="⚙️"
  [add]="➕"
  [remove]="➖"
)

emojify() {
  local text="$1"
  if [[ "$text" =~ ^([a-z]+)(\([^\)]*\))?!?:[[:space:]]* ]]; then
    local type="${BASH_REMATCH[1]}"
    local emoji="${EMOJIS[$type]}"
    if [[ -n "$emoji" ]]; then
      local prefix="${text%%: *}: "
      local rest="${text#*: }"
      echo "${prefix}${emoji} ${rest}"
      return
    fi
  fi
  echo "$text"
}

if [[ "$1" == "--text" ]]; then
  emojify "$2"
else
  emojify "$1"
fi
