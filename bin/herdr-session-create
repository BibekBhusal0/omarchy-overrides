#!/bin/bash

source "$(dirname "$0")/../utils/herdr.sh"

list_entries() {
  local dirs active projects
  dirs=$(zoxide query -l 2>/dev/null)
  active=$(herdr_list_workspaces)

  # Labels shared by several open workspaces, and dirs backing every open
  # workspace (canonicalized). Hiding is directory-based so same-named
  # projects each get their own row until their own directory is open.
  declare -A active_dupe_map open_dir_map ws_dir_map
  while IFS= read -r n; do
    [ -n "$n" ] && active_dupe_map["$n"]=1
  done <<< "$(printf '%s\n' "$active" | cut -f1 | sort | uniq -d)"

  while IFS= read -r row; do
    [ -n "$row" ] || continue
    id=${row#*$'\t'}
    first=1
    while IFS= read -r cwd; do
      [ -n "$cwd" ] || continue
      canon=$(herdr_canonical_path "$cwd")
      open_dir_map["$canon"]=1
      if [ "$first" -eq 1 ]; then
        ws_dir_map["$id"]=$cwd
        first=0
      fi
    done <<< "$(herdr_workspace_cwds "$id")"
  done <<< "$active"

  current=$(herdr_current_workspace_id)
  echo "$active" | while IFS= read -r row; do
    [ -n "$row" ] || continue
    label=${row%%$'\t'*}
    id=${row#*$'\t'}
    marker=""
    [ "$id" = "$current" ] && marker="* "
    if [ "${active_dupe_map[$label]:-}" ] && [ -n "${ws_dir_map[$id]:-}" ]; then
      printf "\033[36m%s%s\033[0m  %s\t%s\tactive\n" "$marker" "$label" "$(herdr_display_path "${ws_dir_map[$id]}")" "$id"
    else
      printf "\033[36m%s%s\033[0m\t%s\tactive\n" "$marker" "$label" "$id"
    fi
  done

  # Project rows; same-named projects also show their (~-collapsed) path.
  projects=$(herdr_list_projects)
  declare -A proj_dupe_map
  while IFS= read -r n; do
    [ -n "$n" ] && proj_dupe_map["$n"]=1
  done <<< "$(printf '%s\n' "$projects" | cut -f1 | sort | uniq -d)"

  printf '%s\n' "$projects" | while IFS= read -r row; do
    [ -n "$row" ] || continue
    name=${row%%$'\t'*}
    d=${row#*$'\t'}
    canon=$(herdr_canonical_path "$d")
    # Directory-based: hide only the project whose own directory is open.
    [ "${open_dir_map[$canon]:-}" ] && continue
    if [ "${proj_dupe_map[$name]:-}" ] || [ "${active_dupe_map[$name]:-}" ]; then
      printf "\033[32m%s\033[0m  %s\t%s\tproject\n" "$name" "$(herdr_display_path "$d")" "$d"
    else
      printf "\033[32m%s\033[0m\t%s\tproject\n" "$name" "$d"
    fi
  done

  echo "$dirs" | while IFS= read -r d; do
    [ -n "$d" ] || continue
    if [ -z "$(herdr_layout_file "$d")" ]; then
      canon=$(herdr_canonical_path "$d")
      [ "${open_dir_map[$canon]:-}" ] && continue
      printf "%s\t%s\tdir\n" "$(herdr_display_path "$d")" "$d"
    fi
  done
}

if [ "${1:-}" = "--list" ]; then
  list_entries
  exit 0
fi

if [ -n "$1" ]; then
  create_or_switch_workspace "$1"
  exit $?
fi

selected=$(
  list_entries | fzf --reverse --ansi --delimiter='\t' --with-nth=1
)
kind=$(echo "$selected" | cut -f3)
target=$(echo "$selected" | cut -f2)

if [ "$kind" = "active" ]; then
  herdr workspace focus "$target"
elif [ -n "$target" ]; then
  create_or_switch_workspace "$target"
fi
