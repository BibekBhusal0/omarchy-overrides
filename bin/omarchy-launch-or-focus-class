#!/bin/bash

# Like omarchy-launch-or-focus but matches ONLY on window class (not title).
# Usage: omarchy-launch-or-focus-class <class-pattern> [launch-command]

if (($# == 0)); then
  echo "Usage: omarchy-launch-or-focus-class [class-pattern] [launch-command]"
  exit 1
fi

CLASS_PATTERN="$1"
LAUNCH_COMMAND="${2:-"uwsm-app -- $CLASS_PATTERN"}"
WINDOW_ADDRESS=$(hyprctl clients -j | jq -r --arg p "$CLASS_PATTERN" '.[]|select(.class|test("\\b" + $p + "\\b";"i"))|.address' | head -n1)

if [[ -n $WINDOW_ADDRESS ]]; then
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$WINDOW_ADDRESS\" })" >/dev/null 2>&1 || hyprctl dispatch focuswindow "address:$WINDOW_ADDRESS"
else
  eval exec setsid $LAUNCH_COMMAND
fi
