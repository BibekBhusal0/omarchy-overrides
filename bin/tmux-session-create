#!/bin/bash

source "$(dirname "$0")/../utils/tmux.sh"

if [ -n "$1" ]; then
  if [ -d "$1" ]; then
    create_or_switch_session "$1"
    exit 0
  else
    echo "Error: Directory '$1' does not exist." >&2
    exit 1
  fi
fi

dirs=$(zoxide query -l 2>/dev/null)
active=$(tmux list-sessions -F "#S" 2>/dev/null)

# Dirs backing every open session (canonicalized). Hiding is
# directory-based so same-named projects each get their own row until
# their own directory is open.
declare -A open_dir_map
while IFS= read -r s; do
  [ -n "$s" ] || continue
  while IFS= read -r cwd; do
    [ -n "$cwd" ] || continue
    canon=$(tmux_canonical_path "$cwd")
    open_dir_map["$canon"]=1
  done <<< "$(tmux_session_cwds "$s")"
done <<< "$active"

# Project rows; same-named projects also show their (~-collapsed) path.
projects=$(tmux_list_projects)
declare -A dupe_map
while IFS= read -r n; do
  [ -n "$n" ] && dupe_map["$n"]=1
done <<< "$(printf '%s\n' "$projects" | cut -f1 | sort | uniq -d)"

selected=$(
  {
    echo "$active" | while IFS= read -r s; do
      [ -n "$s" ] && printf "\033[36m%s\033[0m\t%s\n" "$s" "$s"
    done
    printf '%s\n' "$projects" | while IFS= read -r row; do
      [ -n "$row" ] || continue
      name=${row%%$'\t'*}
      d=${row#*$'\t'}
      canon=$(tmux_canonical_path "$d")
      # Directory-based: hide only the project whose own directory is open.
      [ "${open_dir_map[$canon]:-}" ] && continue
      if [ "${dupe_map[$name]:-}" ]; then
        printf "\033[32m%s\033[0m  %s\t%s\n" "$name" "$(tmux_display_path "$d")" "$d"
      else
        printf "\033[32m%s\033[0m\t%s\n" "$name" "$d"
      fi
    done
    echo "$dirs" | while IFS= read -r d; do
      [ -n "$d" ] || continue
      if [ ! -f "$d/.tmuxinator.yml" ]; then
        canon=$(tmux_canonical_path "$d")
        [ "${open_dir_map[$canon]:-}" ] && continue
        printf "%s\t%s\n" "${d/#$HOME/\~}" "$d"
      fi
    done
  } | fzf --reverse --ansi --delimiter='\t' --with-nth=1 \
    --preview='out=$(tmux capture-pane -e -pt {2}: 2>/dev/null) && echo "$out" | head -80 || eza --tree --level=2 --icons --color=always {2} 2>/dev/null | head -80'
)
selected=$(echo "$selected" | cut -f2-)

if [ -n "$selected" ]; then
  if tmux has-session -t "$selected" 2>/dev/null; then
    switch_to "$selected"
  else
    create_or_switch_session "$selected"
  fi
fi
