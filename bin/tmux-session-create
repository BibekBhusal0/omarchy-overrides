#!/bin/bash

source "$(dirname "$0")/../utils/tmux.sh"

create_or_switch_session() {
  local dir=$1
  local session_name

  session_name=$(basename "$dir" | tr . _)

  if [ -f "$dir/.tmuxinator.yml" ] && command -v tmuxinator >/dev/null 2>&1; then
    (cd "$dir" && tmuxinator start .)
  else
    if ! tmux has-session -t "$session_name" 2>/dev/null; then
      tmux new-session -d -s "$session_name" -c "$dir"
    fi
    switch_to "$session_name"
  fi
}

if [ -n "$1" ]; then
  if [ -d "$1" ]; then
    create_or_switch_session "$1"
    exit 0
  else
    echo "Error: Directory '$1' does not exist." >&2
    exit 1
  fi
fi

dirs=$(zoxide query -l)
selected=$(
  {
    echo "$dirs" | while IFS= read -r d; do
      if [ -f "$d/.tmuxinator.yml" ]; then
        name=$(grep -m1 '^name:' "$d/.tmuxinator.yml" 2>/dev/null | sed 's/^name:[[:space:]]*//')
        display="${name:-$(basename "$d")}"
        printf "\033[32m%s\033[0m\t%s\n" "$display" "$d"
      fi
    done
    echo "$dirs" | while IFS= read -r d; do
      [ ! -f "$d/.tmuxinator.yml" ] && printf "%s\t%s\n" "$d" "$d"
    done
  } | fzf --reverse --ansi --delimiter='\t' --with-nth=1 \
    --preview='eza --tree --level=2 --icons --color=always {2} | head -80'
)
selected=$(echo "$selected" | cut -f2-)

if [ -n "$selected" ]; then
  create_or_switch_session "$selected"
fi
