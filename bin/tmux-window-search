#!/bin/bash

in_tmux() {
    [ -n "$TMUX" ]
}

switch_to() {
    local target=$1
    if in_tmux; then
        tmux switch-client -t "$target"
    else
        tmux attach-session -t "$target"
    fi
}

# Pipe delimiter handles session names containing colons
selected=$(tmux list-windows -a -F "#S|#I|#W" 2>/dev/null | fzf --reverse --header "Search Windows" \
    --delimiter "|" \
    --preview 'tmux capture-pane -e -pt {1}:{2} | head -100')

if [ -n "$selected" ]; then
    session=$(echo "$selected" | cut -d'|' -f1)
    window=$(echo "$selected" | cut -d'|' -f2)
    switch_to "$session:$window"
fi
