#!/bin/bash

# Function to check if we are in tmux
in_tmux() {
    [ -n "$TMUX" ]
}

# Function to switch to a session/window
switch_to() {
    local target=$1
    if in_tmux; then
        tmux switch-client -t "$target"
    else
        tmux attach-session -t "$target"
    fi
}

selected=$(tmux list-windows -a -F "#S:#I: #W" 2>/dev/null | fzf --reverse --header "Search Windows" --preview '
    item={1}
    session=${item%%:*}
    window_idx=$(echo $item | cut -d: -f2)
    tmux list-panes -t "$session:$window_idx" -F "#{pane_current_command} #{pane_title}" | head -20
')

if [ -n "$selected" ]; then
    target=$(echo "$selected" | cut -d: -f1,2)
    switch_to "$target"
fi
