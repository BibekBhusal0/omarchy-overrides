#!/bin/bash

source "$(dirname "$0")/../utils/tmux.sh"

# Pipe delimiter handles session names containing colons
selected=$(tmux list-windows -a -F "#S|#I|#W" 2>/dev/null | fzf --reverse --header "Search Windows (Ctrl-d: Kill)" \
  --delimiter "|" \
  --bind 'ctrl-d:execute(tmux kill-window -t {1}:{2})+reload(tmux list-windows -a -F "#S|#I|#W")' \
  --preview 'tmux capture-pane -e -pt {1}:{2} | head -100')

if [ -n "$selected" ]; then
  session=$(echo "$selected" | cut -d'|' -f1)
  window=$(echo "$selected" | cut -d'|' -f2)
  switch_to "$session:$window"
fi
