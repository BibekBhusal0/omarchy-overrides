#!/usr/bin/env bash
# Start or switch the cliamp daemon between profiles.
# Usage:
#   cliamp-daemon          -> Start default (lofi) if not running, or no-op
#   cliamp-daemon toggle   -> Toggle between lofi and ytm-rs
#   cliamp-daemon lofi     -> Start/switch to lofi
#   cliamp-daemon ytm-rs   -> Start/switch to ytm-rs
set -euo pipefail

STATE_FILE="${XDG_RUNTIME_DIR:-/tmp}/cliamp-daemon.state"
ACTION="${1:-default}"

CURRENT_PROFILE="lofi"
if [[ -f "$STATE_FILE" ]]; then
  CURRENT_PROFILE="$(cat "$STATE_FILE")"
fi

case "$ACTION" in
  toggle)
    if [[ "$CURRENT_PROFILE" == "lofi" ]]; then
      PROFILE="ytm-rs"
    else
      PROFILE="lofi"
    fi
    ;;
  ytm-rs|ytm|youtube)
    PROFILE="ytm-rs"
    ;;
  lofi)
    PROFILE="lofi"
    ;;
  default|*)
    PROFILE="lofi"
    ;;
esac

case "$PROFILE" in
  ytm-rs)
    MUSIC_DIR="${YTM_MUSIC_DIR:-$HOME/Music/ytm-rs}"
    M3U="/tmp/cliamp-ytm-rs.m3u"
    ;;
  lofi|*)
    MUSIC_DIR="${LOFI_MUSIC_DIR:-$HOME/Music/lofimusic}"
    M3U="/tmp/cliamp-lofimusic.m3u"
    ;;
esac

# Record active state
echo "$PROFILE" > "$STATE_FILE"

# Clean up any existing daemon
if pgrep -f '^cliamp --daemon' >/dev/null; then
  pkill -f '^cliamp --daemon'
  sleep 0.5
fi
rm -f "$HOME/.config/cliamp/cliamp.sock"

# cliamp does the only shuffle. It always starts on the first track, so rotate the
# queue at a random point: tracks before it go to the end, relative order untouched.
find "$MUSIC_DIR" -type f \( -iname '*.mp3' -o -iname '*.m4a' -o -iname '*.flac' -o -iname '*.opus' \) | sort > "$M3U"
if [[ -s "$M3U" ]]; then
  mapfile -t TRACKS < "$M3U"
  START=$(( RANDOM % ${#TRACKS[@]} ))
  printf '%s\n' "${TRACKS[@]:START}" "${TRACKS[@]:0:START}" > "$M3U.tmp"
  mv "$M3U.tmp" "$M3U"
fi

nohup cliamp --daemon --shuffle "$M3U" >/dev/null 2>&1 &
disown

echo "cliamp daemon running with profile: $PROFILE"
