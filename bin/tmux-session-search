#!/bin/bash

source "$(dirname "$0")/../utils/tmux.sh"

dirs=$(zoxide query -l 2>/dev/null)
active=$(tmux list-sessions -F "#S" 2>/dev/null)

declare -A active_map
while IFS= read -r s; do
  active_map["$s"]=1
done <<< "$active"

selected=$(
  {
    echo "$active"
    echo "$dirs" | while IFS= read -r d; do
      if [ -f "$d/.tmuxinator.yml" ]; then
        name=$(grep -m1 '^name:' "$d/.tmuxinator.yml" 2>/dev/null | sed 's/^name:[[:space:]]*//')
        display="${name:-$(basename "$d")}"
        [ "${active_map[$display]}" ] && continue
        printf "\033[32m%s\033[0m\t%s\n" "$display" "$d"
      fi
    done
  } | fzf --reverse --ansi --header "Search/Create (Ctrl-d: Kill)" \
    --bind 'ctrl-d:execute(tmux kill-session -t {1})+reload(tmux list-sessions -F "#S")' \
    --preview 'out=$(tmux capture-pane -e -pt {1}: 2>/dev/null) && echo "$out" | head -80 || eza --tree --level=2 --icons --color=always {2} 2>/dev/null | head -80'
)

if [ -n "$selected" ]; then
  if [[ "$selected" == *$'\t'* ]]; then
    create_or_switch_session "${selected#*$'\t'}"
  else
    switch_to "$selected"
  fi
fi
