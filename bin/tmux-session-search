#!/bin/bash

source "$(dirname "$0")/../utils/tmux.sh"
self="$(readlink -f "$0")"

list_entries() {
  local active projects dupes
  active=$(tmux list-sessions -F "#S" 2>/dev/null)
  declare -A active_map dupe_map
  while IFS= read -r s; do active_map["$s"]=1; done <<< "$active"
  echo "$active"

  # Project rows; same-named projects also show their (~-collapsed) path.
  projects=$(tmux_list_projects)
  while IFS= read -r n; do
    [ -n "$n" ] && dupe_map["$n"]=1
  done <<< "$(printf '%s\n' "$projects" | cut -f1 | sort | uniq -d)"

  # Dirs of open sessions whose name is a dupe: their project row is already
  # covered by the active row, so it must not appear twice.
  declare -A open_dir_map
  if [ "${#dupe_map[@]}" -gt 0 ]; then
    while IFS= read -r s; do
      [ -n "$s" ] || continue
      [ "${dupe_map[$s]:-}" ] || continue
      while IFS= read -r cwd; do
        [ -n "$cwd" ] && open_dir_map["$cwd"]=1
      done <<< "$(tmux_session_cwds "$s")"
    done <<< "$active"
  fi

  printf '%s\n' "$projects" | while IFS= read -r row; do
    [ -n "$row" ] || continue
    name=${row%%$'\t'*}
    d=${row#*$'\t'}
    # Dupes are always shown (an open session with the same name would
    # otherwise hide the other project entirely) — except the one that IS open.
    [ "${open_dir_map[$d]:-}" ] && continue
    if [ "${dupe_map[$name]}" ]; then
      printf "\033[32m%s\033[0m  %s\t%s\n" "$name" "$(tmux_display_path "$d")" "$d"
    elif [ "${active_map[$name]}" ]; then
      continue
    else
      printf "\033[32m%s\033[0m\t%s\n" "$name" "$d"
    fi
  done
}

if [ "${1:-}" = "--list" ]; then
  list_entries
  exit 0
fi

selected=$(list_entries | fzf --reverse --ansi --header "Search/Create (Ctrl-d: Kill)" \
  --delimiter='\t' --with-nth=1 \
  --bind "ctrl-d:execute(tmux kill-session -t {1})+reload($self --list)+clear-query" \
  --preview 'out=$(tmux capture-pane -e -pt {1}: 2>/dev/null) && echo "$out" | head -80 || eza --tree --level=2 --icons --color=always {2} 2>/dev/null | head -80'
)

if [ -n "$selected" ]; then
  if [[ "$selected" == *$'\t'* ]]; then
    create_or_switch_session "${selected#*$'\t'}"
  else
    switch_to "$selected"
  fi
fi
