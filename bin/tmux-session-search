#!/bin/bash

# Function to check if we are in tmux
in_tmux() {
    [ -n "$TMUX" ]
}

# Function to switch to a session
switch_to() {
    local target=$1
    if in_tmux; then
        tmux switch-client -t "$target"
    else
        tmux attach-session -t "$target"
    fi
}

selected=$(tmux list-sessions -F "#S" 2>/dev/null | fzf --reverse --header "Search Sessions" --preview '
    session={1}
    tmux list-windows -t "$session" -F "#I: #W (#{window_panes} panes)" | head -20
')

if [ -n "$selected" ]; then
    switch_to "$selected"
fi
