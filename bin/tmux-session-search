#!/bin/bash

in_tmux() {
    [ -n "$TMUX" ]
}

switch_to() {
    local target=$1
    if in_tmux; then
        tmux switch-client -t "$target"
    else
        tmux attach-session -t "$target"
    fi
}

selected=$(tmux list-sessions -F "#S" 2>/dev/null | fzf --reverse --header "Search Sessions" \
    --preview 'tmux list-windows -t {1} -F "#I: #W"; echo "--- Content ---"; tmux capture-pane -e -pt {1}: | head -50')

if [ -n "$selected" ]; then
    switch_to "$selected"
fi
