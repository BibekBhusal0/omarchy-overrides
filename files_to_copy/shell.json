{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "bibek.focusd",
          "icons": {
            "work": "",
            "work-paused": "",
            "short-break": " ",
            "short-break-paused": " ",
            "long-break": "󰒲",
            "long-break-paused": "󰒲"
          }
        },
        {
          "id": "bibek.media"
        }
      ],
      "right": [
        {
          "id": "bibek.ytdl",
          "cookiesBrowser": "zen",
          "extraArgs": "",
          "defaultQuality": "1080p",
          "defaultDownloadType": "video",
          "downloadTranscripts": false,
          "playlistInSeparateFolder": true,
          "enableHistory": true,
          "downloadLocation": "~/Downloads/youtube"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "bibek.obsidian-search"
    },
    {
      "id": "bibek.readest"
    },
    {
      "id": "paisen.menu"
    },
    {
      "id": "esh.confetti"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.dev-gallery",
    "omarchy.media",
    "omarchy.menu"
  ],
  "cloneSourceRestores": [
    "bibek.media",
    "paisen.menu"
  ]
}
