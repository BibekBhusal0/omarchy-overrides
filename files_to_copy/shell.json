{
  "bar": {
    "layout": {
      "center": [
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "left": [
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "bibek.focusd",
          "icons": {
            "work": "",
            "work-paused": "",
            "short-break": " ",
            "short-break-paused": " ",
            "long-break": "󰒲",
            "long-break-paused": "󰒲"
          }
        },
        {
          "id": "bibek.media"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "bibek.ytdl"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        }
      ],
      "centerBegin": [
        {
          "id": "omarchy.indicators"
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.elsewhen",
          "cities": [
            {
              "name": "Kathmandu",
              "zone": "Asia/Kathmandu"
            },
            {
              "name": "Tokyo",
              "zone": "Asia/Tokyo"
            },
            {
              "name": "Los Angeles",
              "zone": "America/Los_Angeles"
            },
            {
              "name": "New York",
              "zone": "America/New_York"
            },
            {
              "name": "London",
              "zone": "Europe/London"
            }
          ]
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "bibek.obsidian-daily",
          "insertHeading": "To-Dos"
        },
        {
          "id": "io.github.janhesters.focus"
        }
      ],
      "tray": []
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "bibek.lock"
    },
    {
      "id": "bibek.obsidian-search"
    },
    {
      "id": "bibek.readest"
    },
    {
      "id": "io.github.weedwhitesandwine.omafetti"
    },
    {
      "id": "io.github.idr4n.clipboard-plus"
    },
    {
      "id": "bibek.menu"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.dev-gallery",
    "omarchy.dock",
    "omarchy.media",
    "omarchy.menu",
    "omarchy.lock"
  ],
  "cloneSourceRestores": [
    "bibek.media",
    "bibek.lock"
  ]
}
